# ============================================================
# ImageGuard AI — Environment Configuration
# Copy this file to .env before starting the application.
# ============================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Database & storage ──────────────────────────────────────
DATABASE_PATH=data/quality.db     # SQLite file location
UPLOAD_DIR=data/uploads           # Stored image previews

# ── Model ───────────────────────────────────────────────────
#
# Two model artifacts are included:
#
#   artifacts/image_quality_model.pt      ← NEW (default)
#     MobileNetV3-Small, trained on KADID-10k + MVTec AD
#     Dual-head: quality regression + 6-class issue detection
#     Version: 2.0.0 | Test MAE: 13.96 | PD ROC-AUC: 0.924
#
#   artifacts/image_quality_model.joblib  ← OLD (legacy fallback)
#     Random Forest, trained on synthetic degraded images only
#     Version: 1.0.0 | Synthetic macro-F1: 0.91 (not real-data)
#
MODEL_PATH=artifacts/image_quality_model.pt

# ── Metrics ─────────────────────────────────────────────────
METRICS_PATH=artifacts/metrics.json

# ── Upload limits ────────────────────────────────────────────
MAX_UPLOAD_MB=10           # Maximum file size accepted (MB)
MAX_IMAGE_PIXELS=40000000  # Maximum decoded pixel count (40 MP)

# ── Pagination ───────────────────────────────────────────────
HISTORY_PAGE_SIZE=20       # Default number of history records per page
